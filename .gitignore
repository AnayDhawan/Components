# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Node (if tooling/tests get added later)
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local / scratch
*.local
scratch/
tmp/

# Generated by scripts/health-check.py, never committed
health-report.md
body.md

# Generated by scripts/build-agent-dirs.sh. Build output, not source: it is
# reproducible from SKILL.md + components.json + references/, and tracking it
# would mean every payload edit carries four near-identical copies in the diff.
# Matches oss-launch, which ignores dist/ and tracks nothing under it.
dist/

# CLI build output, regenerated by cli/'s prepack from scripts/build-agent-dirs.sh
cli/dist/
cli/*.tgz
